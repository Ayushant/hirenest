{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "{dist-server.js,dist/**,index.html}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/jobs/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|assets/|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
