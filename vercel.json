{
  "version": 2,
  "crons": [
    {
      "path": "/api/sheet-sync/pull",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "{dist-server.js,dist/**,index.html}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/jobs/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|assets/|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
