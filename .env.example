# SUPABASE CONFIGURATION (Client + Server Anon Verification)
# Required for HireNestOS database, RLS policies, RPCs, Auth, and private Storage.
# Never use a service-role key here — only the publishable anon key.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# GEMINI_API_KEY: Server-only key for optional Gemini AI suggestion features.
# Never prefix with VITE_. AI Studio automatically injects this at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
