# SUPABASE CONFIGURATION (Client + Server Anon Verification)
# Required for HireNestOS database, RLS policies, RPCs, Auth, and private Storage.
# Never use a service-role key here — only the publishable anon key.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# GEMINI_API_KEY: Server-only key for Gemini AI features (JD skills, JD rewrite, resume parsing, interview questions, screening evaluation, notes tidying, staffing assistant).
# In AI Studio this is injected automatically. On Vercel, add GEMINI_API_KEY in Project Settings -> Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
APP_URL="MY_APP_URL"

# SHEET_SYNC_SECRET: Shared secret for the Google Apps Script job-sheet sync
# (POST /api/sheet-sync/jobs). Set this here and paste the same value into
# the Apps Script SYNC_SECRET constant in scripts/sheet-sync.gs.
SHEET_SYNC_SECRET="MY_SHEET_SYNC_SECRET"

# SCHEDULED GOOGLE SHEETS PULL SYNC (every 5 min via Vercel Cron)
# GOOGLE_SHEET_ID: The spreadsheet ID from the Google Sheet URL
# (e.g. https://docs.google.com/spreadsheets/d/THIS_PART/edit)
GOOGLE_SHEET_ID="MY_GOOGLE_SHEET_ID"

# GOOGLE_SERVICE_ACCOUNT_JSON: Full JSON key from Google Cloud Console
# (IAM > Service Accounts > Keys > Add Key > JSON).
# The service account needs Google Sheets API enabled and read access to the sheet.
# Paste the entire JSON as a single line, or wrap in single quotes.
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}'

# CRON_SECRET: Vercel Cron secret to protect the /api/sheet-sync/pull endpoint.
# Set this in Vercel Project Settings > Environment Variables.
CRON_SECRET="MY_CRON_SECRET"
